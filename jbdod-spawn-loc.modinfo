<?xml version="1.0" encoding="utf-8"?>
<Mod id="jbdod-spawn-loc" version="1" xmlns="ModInfo">

    <Properties>
        <Name>LOC_MODULE_JBDOD_SPAWN_LOC_NAME</Name>
        <Description>LOC_MODULE_JBDOD_SPAWN_LOC_DESCRIPTION</Description>
        <Authors>Jbdod</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>1</AffectsSavedGames>
    </Properties>

    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>

    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>

    <ActionGroups>

        <!-- Game setup screen: the "Human Start Placement" option and the Homeland map types. -->
        <ActionGroup id="jbdod-spawn-loc-shell" scope="shell" criteria="always">
            <Actions>
                <UpdateDatabase>
                    <Item>config/config.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/SpawnLocText.xml</Item>
                    <Item>text/fr_FR/SpawnLocText.xml</Item>
                </UpdateText>
                <!-- Map type icons for the Homeland maps in the map selection screen. -->
                <ImportFiles>
                    <Item>core/ui-next/screens/create-game/create-game-setup-model.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>

        <!-- Map generation: replaces the base start position assignment script. -->
        <ActionGroup id="jbdod-spawn-loc-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/SpawnLocText.xml</Item>
                    <Item>text/fr_FR/SpawnLocText.xml</Item>
                </UpdateText>
                <ImportFiles>
                    <Item>base-standard/maps/assign-starting-plots.js</Item>
                    <Item>maps/continents-homeland.js</Item>
                    <Item>maps/continents-homeland-voronoi.js</Item>
                    <Item>maps/homeland-adrien-voronoi.js</Item>
                    <Item>maps/homeland-voronoi-common.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>

    </ActionGroups>

    <!-- Strings the mod browser needs before the mod loads. -->
    <LocalizedText>
        <File>text/en_us/ModuleText.xml</File>
        <File>text/fr_FR/ModuleText.xml</File>
    </LocalizedText>

</Mod>
